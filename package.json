{
  "name": "@0xkahi/pi-model-select",
  "version": "1.1.1",
  "description": "Pi extension that adds /select-model with favourites and provider-filtered model search",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-management"
  ],
  "author": "0xKahi",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xKahi/pi-model-select.git"
  },
  "files": [
    "src",
    "README.md",
    "config.schema.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "biome": "biome check ./src",
    "lint": "bun biome",
    "lint:fix": "bun biome --write",
    "type-check": "tsc --noEmit",
    "check": "bun run lint:fix && bun run type-check",
    "release": "changeset publish",
    "version": "changeset version",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.0.0",
    "bun-types": "latest",
    "typescript": "^5",
    "@earendil-works/pi-ai": "^0.79.0",
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "^0.79.0"
  }
}
